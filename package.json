{
  "name": "meshflattener-pro",
  "version": "1.0.0",
  "description": "Professional mesh flattening tool for upholstery production",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron-dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "build-electron": "npm run build && electron-builder",
    "lint": "eslint src --ext ts,tsx"
  },
  "dependencies": {
    "three": "^0.165.0",
    "zustand": "^4.5.2",
    "react-dropzone": "^14.2.3",
    "lucide-react": "^0.383.0",
    "@react-three/fiber": "^8.16.8",
    "@react-three/drei": "^9.105.6",
    "three-stdlib": "^2.29.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.165.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.4.5",
    "vite": "^5.3.1",
    "electron": "^31.0.1",
    "electron-builder": "^24.13.3",
    "concurrently": "^8.2.2",
    "wait-on": "^7.2.0",
    "cross-env": "^7.0.3",
    "tailwindcss": "^3.4.4",
    "postcss": "^8.4.38",
    "autoprefixer": "^10.4.19"
  },
  "build": {
    "appId": "com.meshflattener.pro",
    "productName": "MeshFlattener Pro",
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ]
  }
}
